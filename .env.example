# Copy to .env.local for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Without RESEND_API_KEY, `npm run dev` prints inquiries to the terminal instead of emailing.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives new inquiries (comma-separate for more than one)
CONTACT_TO_EMAIL=

# Sender address on a domain you've verified in Resend
CONTACT_FROM_EMAIL="Built by Dylan <inquiries@builtbydylan.dev>"
